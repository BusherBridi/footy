    "move_back":      {"keys": ["S", "Down"],  "pad": ["LeftY+"]},
    "move_left":      {"keys": ["A", "Left"],  "pad": ["LeftX-"]},
    "move_right":     {"keys": ["D", "Right"], "pad": ["LeftX+"]},
